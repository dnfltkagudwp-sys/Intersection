    value: "\u201C\uAC1C\uC778 \uACC4\uC815\uACFC \uC628\uB77C\uC778 \uAE30\uB85D\uC740 \uBAA8\uB450 \uC815\uB9AC\uD574 \uC8FC\uC138\uC694.\u201D"
  - key: ending.request.a
    value: "\u201C\uC6B0\uB9AC \uC544\uC774\uAC00 \uC65C \uAC70\uAE30 \uC788\uC5C8\uB294\uC9C0 \uC54C \uC218 \uC788\uB294 \uAE30\uB85D\uC744 \uBC1C\uACAC\uD558\uC168\uB098\uC694?\u201D"
  - key: ending.outcome.preserved
    value: "\uC77C\uBD80 \uAE30\uB85D\uC740 \uBCF4\uC874 \uC9C0\uC815 \uC0C1\uD0DC\uB85C \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
  - key: ending.outcome.cleared
    value: "\uCD94\uAC00\uB85C \uBCF4\uC874 \uC9C0\uC815\uB41C \uAE30\uB85D \uC5C6\uC774 \uC694\uCCAD\uB41C \uCC98\uB9AC\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: ending.counts
    value: "\uBCF4\uC874 {kept}\uAC74 \xB7 \uC0AD\uC81C {deleted}\uAC74"
  - key: ending.complete
    value: "\uC758\uB8B0 \uCC98\uB9AC \uC644\uB8CC"
  - key: ending.result.heading
    value: "\uCC98\uB9AC \uACB0\uACFC"
  - key: ending.deleted.result
    value: "\uC9C0\uC815\uD55C \uC790\uB8CC\uC758 \uC0AD\uC81C \uCC98\uB9AC\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: ending.deleted.unavailable
    value: "\uD655\uC778\uD560 \uC218 \uC788\uB294 \uAE30\uB85D\uC740 \uB354 \uC774\uC0C1 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uC558\uB2E4."
  - key: ending.deleted.final
    value: "\uC9C4\uC2E4\uC744 \uC99D\uBA85\uD560 \uAE30\uB85D\uC740 \uC0AC\uB77C\uC84C\uACE0,\n\uC0AC\uAC74\uC740 \uAE30\uC874 \uAE30\uB85D\uB300\uB85C \uB0A8\uC558\uB2E4."
  - key: ending.preserved.result
    value: "\uC77C\uBD80 \uAE30\uB85D\uC740 \uBCF4\uC874 \uC0C1\uD0DC\uB85C \uB0A8\uC558\uB2E4."
  - key: ending.later
    value: "\uBA70\uCE60 \uB4A4"
  - key: ending.audit.heading
    value: "\uB0B4\uBD80 \uAC10\uC0AC \uACB0\uACFC \uD1B5\uC9C0"
  - key: ending.audit.body
    value: "\uACC4\uC57D \uBC94\uC704\uB97C \uBC97\uC5B4\uB09C \uC790\uB8CC \uBCF4\uC874 \uC774\uB825\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC5C5\uBB34 \uC811\uADFC \uAD8C\uD55C\uC774 \uD68C\uC218\uB418\uC5C8\uC73C\uBA70, \uACE0\uC6A9 \uACC4\uC57D\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - key: ending.preserved.final
    value: "\uC77C\uC740 \uC783\uC5C8\uC9C0\uB9CC, \uAE30\uB85D\uC740 \uB0A8\uC558\uB2E4.\n\uADF8 \uAE30\uB85D\uC774 \uC5B4\uB514\uB85C \uC774\uC5B4\uC84C\uB294\uC9C0\uB294 \uC54C \uC218 \uC5C6\uB2E4."
  - key: title.name
    value: "\uAD50\uCC28\uC810"
  - key: title.subtitle
    value: "INTERSECTION"
  - key: title.start
    value: "\uC2DC\uC791\uD558\uAE30"
  - key: title.continue
    value: "\uACC4\uC18D\uD558\uAE30"
  - key: title.newGame
    value: "\uC0C8\uB85C \uC2DC\uC791\uD558\uAE30"
  - key: title.result
    value: "\uCC98\uB9AC \uACB0\uACFC \uBCF4\uAE30"
  - key: title.quit
    value: "\uC885\uB8CC"
  - key: title.reset.heading
    value: "\uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC2DC\uC791\uD560\uAE4C\uC694?"
  - key: title.reset.body
    value: "\uC800\uC7A5\uB41C \uC9C4\uD589\uACFC \uC5C5\uBB34 \uAE30\uB85D(\uC5F4\uB78C\u00B7\uACE0\uC815\u00B7\uBD84\uB958\u00B7\uBA54\uBAA8)\uC774 \uBAA8\uB450 \uC9C0\uC6CC\uC9D1\uB2C8\uB2E4.\n\uC5B8\uC5B4\uC640 \uD45C\uC2DC \uC124\uC815\uC740 \uADF8\uB300\uB85C \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - key: title.reset.confirm
    value: "\uC0C8\uB85C \uC2DC\uC791"
  - key: title.reset.cancel
    value: "\uCDE8\uC18C"
  - key: title.reset.failed
    value: "\uC800\uC7A5\uC744 \uCD08\uAE30\uD654\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uAE30\uC874 \uC800\uC7A5\uC740 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4."
  - key: requestIntro.heading
    value: "{case} \uC720\uC871\uC758 \uC694\uCCAD"
  - key: requestIntro.confirm
    value: "\uD655\uC778\uD558\uACE0 \uC2DC\uC791"
  - key: briefing.heading
    value: "\uC5C5\uBB34 \uBC30\uC815 \uC548\uB0B4"
  - key: briefing.body
    value: "\uc624\ub298 \uc811\uc218\ub41c \ub514\uc9c0\ud138 \uc720\uc0b0 \uc815\ub9ac \uc758\ub8b0 \ub450 \uac74\uc744 \ubc30\uc815\ud569\ub2c8\ub2e4.\n\uc11c\uc9c0\ud6c8 \uc528\uc640 \uc724\uc11c\ud558 \uc528\uc758 \ud734\ub300\uc804\ud654 \ubc0f \uc5f0\ub3d9 \uacc4\uc815 \uc815\ub9ac \uac74\uc785\ub2c8\ub2e4.\n\uc720\uc871\uc774 \ubcf4\uc874\uc744 \uc694\uccad\ud55c \uc790\ub8cc\ub294 \uae30\ubcf8\uc73c\ub85c \ub0a8\uae41\ub2c8\ub2e4.\n\uadf8 \ubc16\uc5d0 \ub0a8\uae38 \uc790\ub8cc\ub9cc \u2018\ubcf4\uc874\u2019\uc73c\ub85c \uc9c0\uc815\ud574 \uc8fc\uc138\uc694.\n\ub098\uba38\uc9c0 \uc790\ub8cc\ub294 \uac80\ud1a0\uac00 \ub05d\ub09c \ub4a4 \ucd5c\uc885 \ucc98\ub9ac\uc5d0\uc11c \uc0ad\uc81c\ub429\ub2c8\ub2e4.\n\uc791\uc5c5 \uc911 \ud655\uc778\ud55c \uac1c\uc778 \uc815\ubcf4\ub294 \uc678\ubd80\uc5d0 \uacf5\uac1c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\uba3c\uc800 \uc11c\uc9c0\ud6c8 \uc528 \uac74\ubd80\ud130 \ud655\uc778\ud574 \uc8fc\uc138\uc694."
  - key: briefing.confirm
    value: "\uC694\uCCAD \uD655\uC778\uD558\uAE30"
  - key: language.name
    value: "한국어"
